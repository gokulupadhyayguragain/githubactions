{
  "name": "mini-bank",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "deploy": "wrangler pages deploy .output",
    "db:generate": "wrangler d1 migrations generate mini_bank",
    "db:push": "wrangler d1 execute mini_bank --local --file=migrations/0000_initial.sql",
    "db:seed": "wrangler d1 execute mini_bank --local --command='SELECT * FROM accounts'"
  },
  "dependencies": {
    "next": "14.2.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1",
    "date-fns": "^4.1.0",
    "next-auth": "^4.24.10",
    "@auth/core": "^0.34.2",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.1",
    "typescript": "^5.7.2",
    "tailwindcss": "^3.4.17",
    "postcss": "^8.4.49",
    "autoprefixer": "^10.4.20",
    "wrangler": "^3.94.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.21"
  }
}