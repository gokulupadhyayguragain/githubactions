# Mini Bank Environment Variables
# Copy this file to .env.local for local development

# App URL
NEXT_PUBLIC_APP_URL=https://mini-bank.pages.dev

# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# NEXTAUTH (generate with: openssl rand -base64 32)
NEXTAUTH_URL=https://mini-bank.pages.dev
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars

# Cloudflare D1 Database
# Get from Cloudflare Dashboard > D1 > your database
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token
D1_DATABASE_ID=your-d1-database-id
DB=database_binding_name

# Resend (for email reports)
RESEND_API_KEY=re_xxxxxxxxxxxx

# GitHub Secrets (for CI/CD)
# CLOUDFLARE_API_TOKEN
# CLOUDFLARE_ACCOUNT_ID  
# RESEND_API_KEY
# ACCOUNT_EMAIL=your-email@example.com