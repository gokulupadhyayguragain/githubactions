# Mini Bank Environment Variables
# Copy this file to .env.local for local development

# App URL
NEXT_PUBLIC_APP_URL=https://mini-bank.pages.dev

# Google OAuth (from Google Cloud Console)
# Authorized JavaScript origins: https://mini-bank.pages.dev
# Authorized redirect URIs: https://mini-bank.pages.dev/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# NEXTAUTH (generate with: openssl rand -base64 32)
NEXTAUTH_URL=https://mini-bank.pages.dev
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars

# Cloudflare D1 Database
# Get from Cloudflare Dashboard > D1 > your database
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token
D1_DATABASE_ID=your-d1-database-id

# R2 Storage (for storing PDF receipts)
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=mini-bank-reports
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# Resend (for email reports)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Admin email for receiving CSV reports
ACCOUNT_EMAIL=your-email@example.com